# Copier ce fichier en ".env" puis remplir les valeurs. Ne jamais versionner .env.

# Secret des sessions (obligatoire en production). Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Compte Gmail qui envoie les codes (mot de passe d'application Google).
# Laisser vide en développement : le code s'affiche dans la console du serveur.
EMAIL_USER=
EMAIL_PASS=

# Administrateurs du site (page /admin.html) : adresses mail séparées par des virgules.
# Le rôle n'est accordé qu'aux comptes listés ici.
ADMIN_EMAILS=

# Mettre "production" chez l'hébergeur (cookies sécurisés, secret obligatoire)
NODE_ENV=development

# Port d'écoute (3000 par défaut)
PORT=3000

# Emplacement de la base SQLite. Chez l'hébergeur, choisir un dossier
# persistant (jamais /tmp). Par défaut : database.db à la racine du projet.
DB_PATH=
